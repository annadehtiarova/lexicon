{
  "name": "@jtsage/piper-tts-web",
  "version": "1.2.0",
  "description": "Fork of @realtimex/piper-tts-web for easier built-in PiperTTS use (electron mostly)",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "module": "./dist/piper-tts-web.js",
  "types": "./dist/index.d.ts",
  "author": "team@mintplexlabs.com",
  "exports": {
    ".": {
      "import": "./dist/piper-tts-web.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jtsage/piper-tts-web.git"
  },
  "homepage": "https://github.com/jtsage/piper-tts-web#readme",
  "license": "MIT",
  "keywords": [
    "vits",
    "webassembly",
    "emscripten",
    "audio",
    "browser",
    "tts",
    "text-to-speech",
    "speech synthesis",
    "web ai",
    "webnn",
    "piperTTS",
    "AnythingLLM"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -r -f ./dist && tsc && vite build",
    "preview": "vite preview",
    "verify": "yarn build && cd scripts && node refresh-and-validate.mjs && cd .."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^15.2.0",
    "object-deep-compare": "^1.2.0",
    "onnxruntime-web": "=1.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.22.0"
  }
}